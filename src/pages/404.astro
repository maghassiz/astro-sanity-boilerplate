---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
---

<BaseLayout
	title="Page Not Found — My Project"
	description="The page you're looking for doesn't exist or has been moved."
	noindex
>
	<Navigation client:load variant="light" />
	<main class="flex flex-col gap-4 items-center justify-center min-h-[60vh] px-4 text-center">
		<h1 class="font-heading text-h2 text-ink">Page not found</h1>
		<p class="font-body text-body-md text-muted">The page you're looking for doesn't exist or has been moved.</p>
		<a href="/" class="font-body font-medium text-body-md text-ink underline">Back to home</a>
	</main>
</BaseLayout>
