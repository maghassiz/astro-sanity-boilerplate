# Sanity — from sanity.io/manage after creating a project
# PUBLIC_ prefix required: these get bundled into the Studio's client-side code
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity API token with write access — sanity.io/manage → project → API → Tokens
# → Add API token → "Editor" permissions. Only used by one-off seed scripts and
# scripts/framer-import (never exposed to the browser). Not needed for the
# site itself to read content.
SANITY_API_TOKEN=

# Cloudflare R2 — from the Cloudflare dashboard after creating a bucket
# Public base URL assets are served from (custom domain or r2.dev dev URL)
R2_PUBLIC_URL=

# Used only by scripts that upload/manage objects in the bucket directly
# (not exposed to the browser — keep out of client code)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Contact form submit endpoint — the /exec URL from deploying
# scripts/google-apps-script-contact-form.gs as a Google Apps Script Web App
# (see that file's header comment for setup steps). Leave empty to disable
# submission (the form will show an error instead of silently failing).
PUBLIC_CONTACT_FORM_ENDPOINT=

# Site origin used for canonical URLs / sitemap / OG tags. Leave empty during
# local dev — astro.config.mjs falls back to a placeholder pages.dev URL.
PUBLIC_SITE_URL=

# Cloudflare Web Analytics beacon token — Cloudflare dashboard → Analytics
# → Web Analytics → add site → copy the token (not an API token). Leave
# empty to disable the analytics beacon entirely (e.g. local dev/preview).
PUBLIC_CF_BEACON_TOKEN=
